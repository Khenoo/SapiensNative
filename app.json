{
  "expo": {
    "name": "Sapiens",
    "slug": "Sapiens",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sapiens",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sapiens.app"
    },

    "web": {
      "output": "static"
    },

    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "c8b3edfc-2db2-4610-81aa-ab598f969c89"
      }
    }
  }
}